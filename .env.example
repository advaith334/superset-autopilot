# Copy to .env and fill in. Never commit .env.

# ---- Devin ----
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
DEVIN_MAX_CONCURRENT=3
DEVIN_MAX_ACU_PER_DAY=500

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=changeme
GITHUB_TARGET_REPO=<owner>/<repo>

# ---- Postgres ----
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=autopilot
DATABASE_URL=postgresql+psycopg://autopilot:autopilot@postgres:5432/autopilot

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_ARTIFACTS=
S3_BUCKET_CASEFILES=
S3_PRESIGN_TTL_SECONDS=900

# ---- Superset fork (bind-mounted into triage workers) ----
SUPERSET_FORK_PATH=/Users/advaith/Dev/others/superset

LOG_LEVEL=INFO
